<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Icons.xaml πρέπει να συγχωνεύεται ΕΔΩ - βλ. ίδιο σχόλιο στο Light.xaml. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Επιφάνειες - ουδέτερο ανθρακί γκρι (#171717, ρητό αίτημα χρήστη) αντί για το προηγούμενο ζεστό
         καφέ-μαύρο, ώστε το βασικό σκούρο θέμα να είναι πιο "neutral charcoal" (στυλ GitHub/VS Code dark)
         αντί για warm-tinted. Το πορτοκαλί accent (ClaudeBrush) ξεχωρίζει εξίσου καλά πάνω σε ουδέτερο γκρι. -->
    <SolidColorBrush x:Key="PaperBrush" Color="#171717"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#212121"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0D0D0D"/>
    <SolidColorBrush x:Key="LineBrush" Color="#333333"/>

    <!-- Κείμενο -->
    <SolidColorBrush x:Key="InkBrush" Color="#EDEDED"/>
    <SolidColorBrush x:Key="InkSoftBrush" Color="#A3A3A3"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="ClaudeBrush" Color="#D97C52"/>

    <!-- Χρώματα ανά κατηγορία (ίδιες αποχρώσεις με το Light, ελαφρώς πιο ανοιχτά για αντίθεση σε σκούρο φόντο) -->
    <SolidColorBrush x:Key="TextCatBrush" Color="#6B9BC2"/>
    <SolidColorBrush x:Key="ImgCatBrush" Color="#C97FCC"/>
    <SolidColorBrush x:Key="VideoCatBrush" Color="#E06B7C"/>
    <SolidColorBrush x:Key="AudioCatBrush" Color="#5FC08A"/>
    <SolidColorBrush x:Key="CodeCatBrush" Color="#97C158"/>
    <SolidColorBrush x:Key="AgentsCatBrush" Color="#DDA050"/>
    <SolidColorBrush x:Key="ResearchCatBrush" Color="#9880C9"/>
    <SolidColorBrush x:Key="DesignCatBrush" Color="#5FBFC4"/>

</ResourceDictionary>
