<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Επιφάνειες -->
    <SolidColorBrush x:Key="PaperBrush" Color="#FBF8F3"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#F2ECE0"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#2B2620"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E2DACB"/>

    <!-- Κείμενο -->
    <SolidColorBrush x:Key="InkBrush" Color="#2B2620"/>
    <SolidColorBrush x:Key="InkSoftBrush" Color="#766F60"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="ClaudeBrush" Color="#C1633A"/>

    <!-- Χρώματα ανά κατηγορία (8, ισαπέχοντα στον χρωματικό κύκλο) -->
    <SolidColorBrush x:Key="TextCatBrush" Color="#4A7CA5"/>
    <SolidColorBrush x:Key="ImgCatBrush" Color="#B15CB5"/>
    <SolidColorBrush x:Key="VideoCatBrush" Color="#D1495B"/>
    <SolidColorBrush x:Key="AudioCatBrush" Color="#3FA76B"/>
    <SolidColorBrush x:Key="CodeCatBrush" Color="#7CA33A"/>
    <SolidColorBrush x:Key="AgentsCatBrush" Color="#C9822C"/>
    <SolidColorBrush x:Key="ResearchCatBrush" Color="#7A5CB1"/>
    <SolidColorBrush x:Key="DesignCatBrush" Color="#3FA1A7"/>

</ResourceDictionary>
