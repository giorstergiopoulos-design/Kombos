<Window x:Class="Kombos.AnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Αναλυτικά χρήσης"
        Width="520" Height="560" MinWidth="420" MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">

    <Border x:Name="ShellBorder" CornerRadius="8" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2" Opacity="0.32"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="AnalyticsHeader" Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="8,8,0,0" MouseLeftButtonDown="AnalyticsHeader_MouseLeftButtonDown">
                <Grid Height="36" Margin="14,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="&#128202;" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AnalyticsTitleText" Foreground="White" FontSize="13" FontWeight="Bold"
                                   FontFamily="Bahnschrift" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseAnalyticsButton" Content="&#x2715;" Width="34" Height="34" FontSize="11"
                            HorizontalAlignment="Right" Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="CloseAnalyticsButton_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="18,14,18,14">
                <StackPanel>
                    <TextBlock x:Name="SessionsLabelText" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"
                               Foreground="{DynamicResource InkSoftBrush}"/>
                    <TextBlock x:Name="SessionsHintText" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,10"
                               Foreground="{DynamicResource InkSoftBrush}"/>
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Height="160">
                        <Canvas x:Name="SessionsChartCanvas" ClipToBounds="True"/>
                    </Border>
                    <TextBlock x:Name="SessionsEmptyText" TextWrapping="Wrap" FontSize="10.5" Margin="0,10,0,0"
                               Foreground="{DynamicResource InkSoftBrush}" Visibility="Collapsed"/>

                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,14"/>

                    <TextBlock x:Name="CurrentSessionLabelText" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"
                               Foreground="{DynamicResource InkSoftBrush}"/>
                    <StackPanel x:Name="CurrentSessionPanel"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
