<Window x:Class="Kombos.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Εμφάνιση"
        Width="480" Height="600" MinWidth="400" MinHeight="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">

    <Border x:Name="ShellBorder" CornerRadius="8" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2" Opacity="0.32"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: δικό του drag-handle + close, ανεξάρτητο παράθυρο -->
            <Border x:Name="AppearanceHeader" Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="8,8,0,0" MouseLeftButtonDown="AppearanceHeader_MouseLeftButtonDown">
                <Grid Height="36" Margin="14,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="&#127912;" Foreground="White" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AppearanceTitleText" Foreground="White" FontSize="13" FontWeight="Bold"
                                   FontFamily="Bahnschrift" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseAppearanceButton" Content="&#x2715;" Width="34" Height="34" FontSize="11"
                            HorizontalAlignment="Right" Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="CloseAppearanceButton_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,14,16,14">
                <StackPanel>
                    <TextBlock x:Name="ThemeModeLabelText" FontSize="11" Margin="0,0,0,4"
                               Foreground="{DynamicResource InkSoftBrush}"/>
                    <Button x:Name="ThemeModeButton" Padding="10" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="ThemeModeButton_Click"
                            Margin="0,0,0,10"/>
                    <TextBlock x:Name="SkinLabelText" FontSize="11" Margin="0,0,0,4"
                               Foreground="{DynamicResource InkSoftBrush}"/>
                    <ComboBox x:Name="SkinCombo" Margin="0,0,0,10" SelectionChanged="SkinCombo_SelectionChanged"/>
                    <TextBlock x:Name="TransparencyLabelText" FontSize="11" Margin="0,0,0,4"
                               Foreground="{DynamicResource InkSoftBrush}"/>
                    <Button x:Name="TransparencyButton" Padding="10" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="TransparencyButton_Click"/>
                    <TextBlock x:Name="BgStyleLabelText" FontSize="11" Margin="0,10,0,4"
                               Foreground="{DynamicResource InkSoftBrush}"/>
                    <ComboBox x:Name="BgStyleCombo" Margin="0,0,0,10" SelectionChanged="BgStyleCombo_SelectionChanged"/>
                    <TextBlock x:Name="SidebarPosLabelText" FontSize="11" Margin="0,10,0,4"
                               Foreground="{DynamicResource InkSoftBrush}"/>
                    <Button x:Name="SidebarPosButton" Padding="10" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="SidebarPosButton_Click"/>
                    <TextBlock x:Name="ChatTextScaleLabelText" FontSize="11" Margin="0,10,0,4"
                               Foreground="{DynamicResource InkSoftBrush}"/>
                    <Button x:Name="ChatTextScaleButton" Padding="10" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="ChatTextScaleButton_Click"/>
                    <TextBlock x:Name="AppearanceLiveNoteText" TextWrapping="Wrap" FontSize="10" Margin="0,14,0,0"
                               Foreground="{DynamicResource InkSoftBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
