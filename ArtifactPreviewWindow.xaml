<Window x:Class="Kombos.ArtifactPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Προεπισκόπηση Artifact"
        Width="720" Height="640" MinWidth="360" MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">

    <Border x:Name="ShellBorder" CornerRadius="8" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2" Opacity="0.32"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- "Artifact live preview" (v4.5.0) - βλ. ArtifactPreviewWindow.xaml.cs -->
            <Border x:Name="PreviewHeader" Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="8,8,0,0" MouseLeftButtonDown="PreviewHeader_MouseLeftButtonDown">
                <Grid Height="36" Margin="14,0,4,0">
                    <TextBlock x:Name="PreviewTitleText" Foreground="White" FontSize="13" FontWeight="Bold"
                               FontFamily="Bahnschrift" VerticalAlignment="Center"/>
                    <Button x:Name="ClosePreviewButton" Content="&#x2715;" Width="34" Height="34" FontSize="11"
                            HorizontalAlignment="Right" Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="ClosePreviewButton_Click"/>
                </Grid>
            </Border>

            <Grid x:Name="PreviewContentHost" Grid.Row="1" Margin="1" Background="White"/>
        </Grid>
    </Border>
</Window>
