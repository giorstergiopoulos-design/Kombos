<Window x:Class="Kombos.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Λογαριασμοί"
        Width="560" Height="660" MinWidth="460" MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">

    <Border x:Name="ShellBorder" CornerRadius="8" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2" Opacity="0.32"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="AccountsHeader" Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="8,8,0,0" MouseLeftButtonDown="AccountsHeader_MouseLeftButtonDown">
                <Grid Height="36" Margin="14,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="&#x1F510;" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AccountsTitleText" Foreground="White" FontSize="13" FontWeight="Bold"
                                   FontFamily="Bahnschrift" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseAccountsButton" Content="&#x2715;" Width="34" Height="34" FontSize="11"
                            HorizontalAlignment="Right" Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="CloseAccountsButton_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,10,14,14">
                <StackPanel>
                    <TextBlock x:Name="AccountsHintText" TextWrapping="Wrap" FontSize="10.5" Margin="0,0,0,12"
                               Foreground="{DynamicResource InkSoftBrush}"/>
                    <StackPanel x:Name="AccountsListPanel"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
