<Window x:Class="Kombos.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ρυθμίσεις"
        Width="380" Height="560" MinWidth="340" MinHeight="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">

    <Border x:Name="ShellBorder" CornerRadius="8" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2" Opacity="0.32"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: δικό του drag-handle + close, ανεξάρτητο παράθυρο (δεν κλείνει με deactivate) -->
            <Border x:Name="SettingsHeader" Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="8,8,0,0" MouseLeftButtonDown="SettingsHeader_MouseLeftButtonDown">
                <Grid Height="36" Margin="14,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="&#x2699;" Foreground="White" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SettingsTitleText" Foreground="White" FontSize="13" FontWeight="Bold"
                                   FontFamily="Bahnschrift" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseSettingsButton" Content="&#x2715;" Width="34" Height="34" FontSize="11"
                            HorizontalAlignment="Right" Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="CloseSettingsButton_Click"/>
                </Grid>
            </Border>

            <!-- Σώμα: 2 στήλες - η αριστερή (πλάτους 0 εκτός από το skin "Nexus") είναι μια κάθετη ράγα
                 καρτελών στυλ classic Windows Properties dialog· η δεξιά έχει είτε την οριζόντια σειρά
                 pill-tabs (προεπιλογή, με βελάκια κύλισης αριστερά/δεξιά ώστε να ΜΗΝ τυλίγονται ποτέ σε 2η
                 γραμμή) είτε τίποτα όταν ενεργή είναι η κάθετη ράγα. Η καρτέλα Agent & Σύνδεση ΔΕΝ υπάρχει
                 εδώ πια - ζωντανεύει σε δικό της παράθυρο (AgentSettingsWindow), προσβάσιμο ΜΟΝΟ από το "C". -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="VerticalRailColumn" Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="VerticalTabRail" Grid.Column="0" Margin="10,10,4,10" Visibility="Collapsed">
                    <Border x:Name="TabProjectPillV" CornerRadius="6" Padding="8,7" Margin="0,0,0,4"
                            Cursor="Hand" MouseLeftButtonUp="TabProject_Click">
                        <TextBlock x:Name="TabProjectLabelV" FontSize="10" TextWrapping="Wrap"/>
                    </Border>
                    <Border x:Name="TabBehaviorPillV" CornerRadius="6" Padding="8,7" Margin="0,0,0,4"
                            Cursor="Hand" MouseLeftButtonUp="TabBehavior_Click">
                        <TextBlock x:Name="TabBehaviorLabelV" FontSize="10" TextWrapping="Wrap"/>
                    </Border>
                    <Border x:Name="TabPluginsPillV" CornerRadius="6" Padding="8,7" Margin="0,0,0,4"
                            Cursor="Hand" MouseLeftButtonUp="TabPlugins_Click">
                        <TextBlock x:Name="TabPluginsLabelV" FontSize="10" TextWrapping="Wrap"/>
                    </Border>
                    <Border x:Name="TabAboutPillV" CornerRadius="6" Padding="8,7" Margin="0,0,0,4"
                            Cursor="Hand" MouseLeftButtonUp="TabAbout_Click">
                        <TextBlock x:Name="TabAboutLabelV" FontSize="10" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="HorizontalTabStrip" Grid.Row="0" Margin="12,10,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TabStripLeftArrow" Grid.Column="0" Content="&#9664;" Width="20" Padding="0"
                                FontSize="9" Margin="0,0,3,0" Background="Transparent"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Foreground="{DynamicResource InkSoftBrush}" Cursor="Hand" Click="TabStripLeftArrow_Click"/>
                        <ScrollViewer x:Name="TabStripScrollViewer" Grid.Column="1"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="TabProjectPill" CornerRadius="13" Padding="9,5" Margin="0,0,4,0"
                                        Cursor="Hand" MouseLeftButtonUp="TabProject_Click">
                                    <TextBlock x:Name="TabProjectLabel" FontSize="10.5"/>
                                </Border>
                                <Border x:Name="TabBehaviorPill" CornerRadius="13" Padding="9,5" Margin="0,0,4,0"
                                        Cursor="Hand" MouseLeftButtonUp="TabBehavior_Click">
                                    <TextBlock x:Name="TabBehaviorLabel" FontSize="10.5"/>
                                </Border>
                                <Border x:Name="TabPluginsPill" CornerRadius="13" Padding="9,5" Margin="0,0,4,0"
                                        Cursor="Hand" MouseLeftButtonUp="TabPlugins_Click">
                                    <TextBlock x:Name="TabPluginsLabel" FontSize="10.5"/>
                                </Border>
                                <Border x:Name="TabAboutPill" CornerRadius="13" Padding="9,5" Margin="0,0,4,0"
                                        Cursor="Hand" MouseLeftButtonUp="TabAbout_Click">
                                    <TextBlock x:Name="TabAboutLabel" FontSize="10.5"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="TabStripRightArrow" Grid.Column="2" Content="&#9654;" Width="20" Padding="0"
                                FontSize="9" Margin="3,0,0,0" Background="Transparent"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Foreground="{DynamicResource InkSoftBrush}" Cursor="Hand" Click="TabStripRightArrow_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,2,14,14">
                        <Grid>

                    <!-- ================= TAB: PROJECT & ΣΥΖΗΤΗΣΗ ================= -->
                    <StackPanel x:Name="PanelProject">
                        <Button x:Name="ImportProjectButton" Padding="10" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="ImportProjectButton_Click"/>
                        <Button x:Name="ImportFolderButton" Margin="0,6,0,0" Padding="10" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="ImportFolderButton_Click"/>
                        <TextBlock x:Name="ImportProjectHintText" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{DynamicResource InkSoftBrush}"/>

                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,12"/>
                        <TextBlock x:Name="ProjectMemoryLabelText" FontSize="11" Margin="0,0,0,4"
                                   Foreground="{DynamicResource InkSoftBrush}"/>
                        <TextBlock x:Name="ProjectMemoryHintText" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,8"
                                   Foreground="{DynamicResource InkSoftBrush}"/>
                        <Button x:Name="ImportProjectIndexButton" Padding="10" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="ImportProjectIndexButton_Click"/>
                        <TextBlock x:Name="ActiveProjectStatusText" TextWrapping="Wrap" FontSize="10" Margin="0,6,0,0"
                                   Foreground="{DynamicResource InkSoftBrush}"/>
                        <Button x:Name="VerifyProjectButton" Margin="0,8,0,0" Padding="10" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="VerifyProjectButton_Click"/>
                        <Button x:Name="ExportChatButton" Margin="0,8,0,0" Padding="10" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="ExportChatButton_Click"/>

                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,12"/>
                        <Button x:Name="ExportBackupButton" Padding="10" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="ExportBackupButton_Click"/>
                        <Button x:Name="ImportBackupButton" Margin="0,6,0,0" Padding="10" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="ImportBackupButton_Click"/>
                        <Button x:Name="ImportChatExportButton" Margin="0,6,0,0" Padding="10" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="ImportChatExportButton_Click"/>
                        <TextBlock x:Name="ImportChatExportHintText" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{DynamicResource InkSoftBrush}"/>

                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,12"/>
                        <Button x:Name="ClearAllConversationsButton" Padding="10" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderBrush="#C0392B" BorderThickness="1"
                                Foreground="#C0392B" Cursor="Hand" Click="ClearAllConversationsButton_Click"/>

                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,12"/>
                        <TextBlock x:Name="SyncFolderLabelText" FontSize="11" Margin="0,0,0,4"
                                   Foreground="{DynamicResource InkSoftBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SyncFolderBox" Grid.Column="0" Padding="6" FontSize="10.5" IsReadOnly="True"
                                     Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}"
                                     BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
                            <Button x:Name="BrowseSyncFolderButton" Grid.Column="1" Content="📁" Width="34" Margin="6,0,0,0"
                                    Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="BrowseSyncFolderButton_Click"/>
                            <Button x:Name="ResetSyncFolderButton" Grid.Column="2" Content="✕" Width="34" Margin="6,0,0,0"
                                    Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="ResetSyncFolderButton_Click"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock x:Name="SyncFolderHintText" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{DynamicResource InkSoftBrush}"/>

                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,12"/>
                        <TextBlock x:Name="SharedProjectsLabelText" FontSize="11" Margin="0,0,0,4"
                                   Foreground="{DynamicResource InkSoftBrush}"/>
                        <TextBlock x:Name="SharedProjectsHintText" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,8"
                                   Foreground="{DynamicResource InkSoftBrush}"/>
                        <Button x:Name="PublishActiveProjectButton" Padding="10" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="PublishActiveProjectButton_Click"/>
                        <StackPanel x:Name="SharedProjectsListPanel" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- ================= TAB: ΣΥΜΠΕΡΙΦΟΡΑ ΕΦΑΡΜΟΓΗΣ ================= -->
                    <StackPanel x:Name="PanelBehavior" Visibility="Collapsed">
                        <CheckBox x:Name="AlwaysOnTopCheckBox" FontSize="12" Margin="0,0,0,10"
                                  Foreground="{DynamicResource InkBrush}" Checked="AlwaysOnTopCheckBox_Changed"
                                  Unchecked="AlwaysOnTopCheckBox_Changed"/>
                        <CheckBox x:Name="StartWithWindowsCheckBox" FontSize="12" Margin="0,0,0,10"
                                  Foreground="{DynamicResource InkBrush}" Checked="StartWithWindowsCheckBox_Changed"
                                  Unchecked="StartWithWindowsCheckBox_Changed"/>
                        <CheckBox x:Name="StartMinimizedCheckBox" FontSize="12" Margin="0,0,0,4"
                                  Foreground="{DynamicResource InkBrush}" Checked="StartMinimizedCheckBox_Changed"
                                  Unchecked="StartMinimizedCheckBox_Changed"/>
                        <TextBlock x:Name="StartMinimizedHintText" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,14"
                                   Foreground="{DynamicResource InkSoftBrush}"/>
                        <CheckBox x:Name="SoundOnReplyCheckBox" FontSize="12" Margin="0,0,0,10"
                                  Foreground="{DynamicResource InkBrush}" Checked="SoundOnReplyCheckBox_Changed"
                                  Unchecked="SoundOnReplyCheckBox_Changed"/>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>
                        <TextBlock x:Name="HotkeyInfoText" TextWrapping="Wrap" FontSize="10.5"
                                   Foreground="{DynamicResource InkSoftBrush}"/>
                    </StackPanel>

                    <!-- ================= TAB: ΕΠΕΚΤΑΣΕΙΣ (PLUGINS) ================= -->
                    <StackPanel x:Name="PanelPlugins" Visibility="Collapsed">
                        <TextBlock x:Name="PluginsFolderHintText" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,10"
                                   Foreground="{DynamicResource InkSoftBrush}"/>
                        <Button x:Name="OpenPluginsFolderButton" Padding="10" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="OpenPluginsFolderButton_Click"/>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,10"/>
                        <StackPanel x:Name="PluginsListPanel"/>
                        <TextBlock x:Name="PluginsRestartHintText" TextWrapping="Wrap" FontSize="10" Margin="0,10,0,0"
                                   Foreground="{DynamicResource InkSoftBrush}"/>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,10"/>
                        <TextBlock x:Name="GalleryHeaderText" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock x:Name="GalleryHintText" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,10"
                                   Foreground="{DynamicResource InkSoftBrush}"/>
                        <StackPanel x:Name="GalleryListPanel"/>

                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,10"/>
                        <TextBlock x:Name="PluginSdkHeaderText" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock x:Name="PluginSdkHintText" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,8"
                                   Foreground="{DynamicResource InkSoftBrush}"/>
                        <TextBox x:Name="NewPluginNameBox" Padding="6" Margin="0,0,0,6"
                                 Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}"
                                 BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
                        <Button x:Name="ScaffoldPluginButton" Padding="10" HorizontalContentAlignment="Left" HorizontalAlignment="Left"
                                Background="Transparent" BorderBrush="{DynamicResource ClaudeBrush}" BorderThickness="1"
                                Foreground="{DynamicResource ClaudeBrush}" Cursor="Hand" Click="ScaffoldPluginButton_Click"/>
                        <TextBlock x:Name="ScaffoldResultText" TextWrapping="Wrap" FontSize="10" Margin="0,8,0,0"
                                   Foreground="{DynamicResource InkSoftBrush}"/>

                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,10"/>
                        <TextBlock x:Name="MarketplaceHeaderText" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock x:Name="MarketplaceHintText" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,8"
                                   Foreground="{DynamicResource InkSoftBrush}"/>
                        <Button x:Name="InstallFromFolderButton" Padding="10" Margin="0,0,0,8" HorizontalContentAlignment="Left" HorizontalAlignment="Left"
                                Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="InstallFromFolderButton_Click"/>
                        <TextBox x:Name="MarketplaceGitUrlBox" Padding="6" Margin="0,0,0,6"
                                 Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}"
                                 BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
                        <Button x:Name="InstallFromGitButton" Padding="10" HorizontalContentAlignment="Left" HorizontalAlignment="Left"
                                Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="InstallFromGitButton_Click"/>
                        <TextBlock x:Name="MarketplaceResultText" TextWrapping="Wrap" FontSize="10" Margin="0,8,0,0"
                                   Foreground="{DynamicResource InkSoftBrush}"/>
                    </StackPanel>

                    <!-- ================= TAB: ΠΛΗΡΟΦΟΡΙΕΣ ================= -->
                    <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                        <Expander x:Name="HelpExpander" FontSize="14" FontWeight="Bold" IsExpanded="True"
                                  Foreground="{DynamicResource InkBrush}">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock x:Name="HelpBodyText" TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                           Foreground="{DynamicResource InkSoftBrush}"/>
                                <Button x:Name="ReplayOnboardingButton" Margin="0,10,0,0" Padding="8,6" FontWeight="Normal"
                                        HorizontalContentAlignment="Left" HorizontalAlignment="Left"
                                        Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="ReplayOnboardingButton_Click"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="UpdatesExpander" Margin="0,10,0,0" FontSize="14" FontWeight="Bold"
                                  Foreground="{DynamicResource InkBrush}">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock x:Name="UpdatesHintText" TextWrapping="Wrap" FontSize="10" FontWeight="Normal" Margin="0,0,0,6"
                                           Foreground="{DynamicResource InkSoftBrush}"/>
                                <TextBox x:Name="UpdateRepoBox" Padding="5" FontSize="10.5" Margin="0,0,0,6"
                                         Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}"
                                         BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                         LostFocus="UpdateRepoBox_LostFocus"/>
                                <Button x:Name="CheckUpdateButton" Padding="8,6" FontWeight="Normal"
                                        HorizontalContentAlignment="Left" HorizontalAlignment="Left"
                                        Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="CheckUpdateButton_Click"/>
                                <TextBlock x:Name="UpdateResultText" TextWrapping="Wrap" FontSize="10" FontWeight="Normal" Margin="0,8,0,0"
                                           Foreground="{DynamicResource InkSoftBrush}" Cursor="Hand" MouseLeftButtonUp="UpdateResultText_MouseLeftButtonUp"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="HistoryExpander" Margin="0,10,0,0" FontSize="14" FontWeight="Bold"
                                  Foreground="{DynamicResource InkBrush}">
                            <TextBlock x:Name="HistoryBodyText" TextWrapping="Wrap" FontSize="10" FontWeight="Normal" Margin="0,6,0,0"
                                       Foreground="{DynamicResource InkSoftBrush}"/>
                        </Expander>
                        <Expander x:Name="DisclaimerExpander" Margin="0,10,0,0" Foreground="{DynamicResource InkSoftBrush}">
                            <TextBlock x:Name="DisclaimerBodyText" TextWrapping="Wrap" FontSize="10" Margin="0,6,0,0"
                                       Foreground="{DynamicResource InkSoftBrush}"/>
                        </Expander>
                    </StackPanel>

                </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
