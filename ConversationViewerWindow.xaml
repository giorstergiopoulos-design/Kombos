<Window x:Class="Kombos.ConversationViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Κόμβος — Συζήτηση"
        Width="640" Height="720" MinWidth="480" MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual">

    <Border x:Name="ShellBorder" CornerRadius="8" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2" Opacity="0.32"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Ανεξάρτητο παράθυρο (v4.5.0, "Multi-window") - δικό του drag-handle + close, δικό του σχήμα
                 header/footer, ίδιο πνεύμα με τα υπόλοιπα δευτερεύοντα παράθυρα (SkinChrome.ApplySquareIfClassic). -->
            <Border x:Name="ViewerHeader" Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="8,8,0,0" MouseLeftButtonDown="ViewerHeader_MouseLeftButtonDown">
                <Grid Height="36" Margin="14,0,4,0">
                    <TextBlock x:Name="ViewerTitleText" Foreground="White" FontSize="13" FontWeight="Bold"
                               FontFamily="Bahnschrift" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="0,0,40,0"/>
                    <Button x:Name="CloseViewerButton" Content="&#x2715;" Width="34" Height="34" FontSize="11"
                            HorizontalAlignment="Right" Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="CloseViewerButton_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,14,16,14">
                <StackPanel x:Name="ViewerLogPanel"/>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,8" CornerRadius="0,0,8,8">
                <Button x:Name="CopyAllButton" Padding="8,5" HorizontalAlignment="Left"
                        Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="CopyAllButton_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
