<Window x:Class="Kombos.AgentSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent"
        Width="380" Height="560" MinWidth="340" MinHeight="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">

    <Border x:Name="ShellBorder" CornerRadius="8" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2" Opacity="0.32"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Ξεχωριστό παράθυρο (όχι tab μέσα στις γενικές Ρυθμίσεις) - το μόνο σημείο εισόδου είναι το
                 κουμπί "C" (avatar) στην πλευρική μπάρα, όπως έχει ζητηθεί επανειλημμένα. Το γρανάζι ανοίγει
                 αποκλειστικά τις γενικές ρυθμίσεις εφαρμογής (SettingsWindow) - καμία επικάλυψη μεταξύ τους. -->
            <Border x:Name="AgentHeader" Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="8,8,0,0" MouseLeftButtonDown="AgentHeader_MouseLeftButtonDown">
                <Grid Height="36" Margin="14,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="C" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AgentTitleText" Foreground="White" FontSize="13" FontWeight="Bold"
                                   FontFamily="Bahnschrift" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseAgentSettingsButton" Content="&#x2715;" Width="34" Height="34" FontSize="11"
                            HorizontalAlignment="Right" Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="CloseAgentSettingsButton_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,10,14,14">
                <StackPanel>
                    <TextBlock x:Name="SettingsAgentLabelText" FontSize="11" Margin="0,0,0,4"
                               Foreground="{DynamicResource InkSoftBrush}"/>
                    <ComboBox x:Name="AgentSelectCombo" Margin="0,0,0,10" SelectionChanged="AgentSelectCombo_SelectionChanged"/>
                    <TextBlock x:Name="SettingsKeyLabelText" FontSize="11" Margin="0,0,0,4"
                               Foreground="{DynamicResource InkSoftBrush}"/>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="AgentApiKeyBox" Grid.Column="0" Padding="5" PasswordChanged="AgentApiKeyBox_PasswordChanged" LostFocus="AgentApiKeyBox_LostFocus"/>
                        <Button x:Name="PasteApiKeyButton" Grid.Column="1" Content="📋" Width="30" Margin="4,0,0,0"
                                Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="PasteApiKeyButton_Click"
                                ToolTip="Επικόλληση από το πρόχειρο" AutomationProperties.Name="Επικόλληση κλειδιού API"/>
                    </Grid>
                    <TextBlock x:Name="SettingsHintText" TextWrapping="Wrap" FontSize="10.5" Margin="0,10,0,0"
                               Foreground="{DynamicResource InkSoftBrush}"/>
                    <Button x:Name="SetCentralAgentButton" Margin="0,12,0,0" Padding="10" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderBrush="{DynamicResource ClaudeBrush}" BorderThickness="1"
                            Foreground="{DynamicResource ClaudeBrush}" Cursor="Hand" Click="SetCentralAgentButton_Click"/>
                    <TextBlock x:Name="CentralAgentStatusText" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"
                               Foreground="{DynamicResource InkSoftBrush}"/>

                    <!-- v4.6.0 UX pass: 6 άσχετες μεταξύ τους ενότητες ήταν όλες ανοιχτές σε έναν ατελείωτο
                         κατάλογο - "υπερσυγκέντρωση" κατά ρητή παρατήρηση χρήστη. Μόνο το πιο συχνά
                         χρησιμοποιούμενο (κλειδί + ορισμός κεντρικού agent, πάνω) μένει πάντα ορατό· τα
                         υπόλοιπα διπλώνουν σε Expanders (ίδιο μοτίβο με SettingsWindow → Πληροφορίες), ώστε ο
                         χρήστης να ανοίγει μόνο ό,τι πραγματικά χρειάζεται τη δεδομένη στιγμή. -->
                    <Expander x:Name="LoginCredentialsExpander" Margin="0,18,0,0" FontSize="12" FontWeight="Bold"
                              Foreground="{DynamicResource InkBrush}">
                        <StackPanel Margin="0,10,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AgentUsernameBox" Grid.Column="0" Padding="5"
                                         Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}"
                                         BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                         LostFocus="AgentUsernameBox_LostFocus"/>
                                <Button x:Name="PasteUsernameButton" Grid.Column="1" Content="📋" Width="30" Margin="4,0,0,0"
                                        Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="PasteUsernameButton_Click"
                                        ToolTip="Επικόλληση από το πρόχειρο" AutomationProperties.Name="Επικόλληση username"/>
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="AgentPasswordBox" Grid.Column="0" Padding="5" PasswordChanged="AgentPasswordBox_PasswordChanged" LostFocus="AgentPasswordBox_LostFocus"/>
                                <Button x:Name="PastePasswordButton" Grid.Column="1" Content="📋" Width="30" Margin="4,0,0,0"
                                        Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="PastePasswordButton_Click"
                                        ToolTip="Επικόλληση από το πρόχειρο" AutomationProperties.Name="Επικόλληση password"/>
                            </Grid>
                            <TextBlock x:Name="LoginCredentialsHintText" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"
                                       Foreground="{DynamicResource InkSoftBrush}"/>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="InstructionsExpander" Margin="0,10,0,0" FontSize="12" FontWeight="Bold"
                              Foreground="{DynamicResource InkBrush}">
                        <StackPanel Margin="0,10,0,0">
                            <TextBox x:Name="CustomInstructionsBox" Padding="6" MinHeight="70" MaxHeight="160"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}"
                                     BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                     LostFocus="CustomInstructionsBox_LostFocus"/>
                            <TextBlock x:Name="CustomInstructionsHintText" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,12"
                                       Foreground="{DynamicResource InkSoftBrush}"/>

                            <TextBlock x:Name="PresetsLabelText" FontSize="11" Margin="0,0,0,4"
                                       Foreground="{DynamicResource InkSoftBrush}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PresetsCombo" Grid.Column="0" SelectionChanged="PresetsCombo_SelectionChanged"/>
                                <Button x:Name="DeletePresetButton" Grid.Column="1" Content="&#128465;" Width="34" Margin="6,0,0,0"
                                        Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="DeletePresetButton_Click"/>
                            </Grid>
                            <Button x:Name="SavePresetButton" Padding="8,6" HorizontalContentAlignment="Left" HorizontalAlignment="Left" FontSize="10.5"
                                    Background="Transparent" BorderBrush="{DynamicResource ClaudeBrush}" BorderThickness="1"
                                    Foreground="{DynamicResource ClaudeBrush}" Cursor="Hand" Click="SavePresetButton_Click"/>
                            <TextBox x:Name="PresetNameBox" Visibility="Collapsed" Margin="0,6,0,0" Padding="5"
                                     Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}"
                                     BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                     KeyDown="PresetNameBox_KeyDown" LostFocus="PresetNameBox_LostFocus"/>
                            <TextBlock x:Name="PresetsHintText" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"
                                       Foreground="{DynamicResource InkSoftBrush}"/>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="McpExpander" Margin="0,10,0,0" FontSize="12" FontWeight="Bold"
                              Foreground="{DynamicResource InkBrush}">
                        <StackPanel Margin="0,10,0,0">
                            <TextBox x:Name="McpServersBox" Padding="6" MinHeight="50" MaxHeight="100"
                                     AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                     Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}"
                                     BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                     LostFocus="McpServersBox_LostFocus"/>
                            <TextBlock x:Name="McpServersHintText" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"
                                       Foreground="{DynamicResource InkSoftBrush}"/>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="HiveMemoryExpander" Margin="0,10,0,0" FontSize="12" FontWeight="Bold"
                              Foreground="{DynamicResource InkBrush}">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock x:Name="HiveMemoryHintText" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,8"
                                       Foreground="{DynamicResource InkSoftBrush}"/>
                            <StackPanel x:Name="HiveMemoryListPanel" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HiveMemoryAddBox" Grid.Column="0" Padding="6" FontSize="11"
                                         Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}"
                                         BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                         KeyDown="HiveMemoryAddBox_KeyDown"/>
                                <Button x:Name="HiveMemoryAddButton" Grid.Column="1" Content="+" Width="34" Margin="6,0,0,0"
                                        Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Foreground="{DynamicResource InkBrush}" Cursor="Hand" Click="HiveMemoryAddButton_Click"/>
                            </Grid>
                            <Button x:Name="HiveMemoryClearButton" Margin="0,8,0,0" Padding="8,6" HorizontalContentAlignment="Left"
                                    HorizontalAlignment="Left" FontSize="10.5"
                                    Background="Transparent" BorderBrush="#C0392B" BorderThickness="1"
                                    Foreground="#C0392B" Cursor="Hand" Click="HiveMemoryClearButton_Click"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
